{"id":1,"name":"الفاتحة","ayahs":[{"n":1,"text":"بِسْمِ اِ۬للَّهِ اِ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ"},{"n":2,"text":"اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ"},{"n":3,"text":"اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ"},{"n":4,"text":"مَلِكِ يَوْمِ اِ۬لدِّينِۖ"},{"n":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ"},{"n":6,"text":"اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ"},{"n":7,"text":"صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ"}]}