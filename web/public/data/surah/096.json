{"id":96,"name":"العلق","ayahs":[{"n":1,"text":"اَ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ"},{"n":2,"text":"خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ"},{"n":3,"text":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ"},{"n":4,"text":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ"},{"n":5,"text":"عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ"},{"n":6,"text":"كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪ىٰٓ"},{"n":7,"text":"أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪ىٰٓۖ"},{"n":8,"text":"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْع۪ىٰٓۖ"},{"n":9,"text":"أَرَٰٓيْتَ اَ۬لذِے يَنْه۪ىٰ"},{"n":10,"text":"عَبْداً اِذَا صَلّ۪ىٰٓۖ"},{"n":11,"text":"أَرَٰٓيْتَ إِن كَانَ عَلَى اَ۬لْهُد۪ىٰٓ"},{"n":12,"text":"أَوَ اَمَرَ بِالتَّقْو۪ىٰٓۖ"},{"n":13,"text":"أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪ىٰٓ"},{"n":14,"text":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪ىٰۖ"},{"n":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ"},{"n":16,"text":"لَنَسْفَعاَۢ بِالنَّاصِيَةِ"},{"n":17,"text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖۖ"},{"n":18,"text":"فَلْيَدْعُ نَادِيَهُۥ"},{"n":19,"text":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ"},{"n":20,"text":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ۩"}]}