{"id":77,"name":"المرسلات","ayahs":[{"n":1,"text":"وَالْمُرْسَلَٰتِ عُرْفاٗ"},{"n":2,"text":"فَالْعَٰصِفَٰتِ عَصْفاٗ"},{"n":3,"text":"وَالنَّٰشِرَٰتِ نَشْراٗ"},{"n":4,"text":"فَالْفَٰرِقَٰتِ فَرْقاٗ"},{"n":5,"text":"فَالْمُلْقِيَٰتِ ذِكْراً"},{"n":6,"text":"عُذْراً اَوْ نُذُراً"},{"n":7,"text":"اِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ"},{"n":8,"text":"فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ"},{"n":9,"text":"وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ"},{"n":10,"text":"وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ"},{"n":11,"text":"وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ"},{"n":12,"text":"لِأَيِّ يَوْمٍ ا۟جِّلَتْ"},{"n":13,"text":"لِيَوْمِ اِ۬لْفَصْلِۖ"},{"n":14,"text":"وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ"},{"n":15,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":16,"text":"أَلَمْ نُهْلِكِ اِ۬لَاوَّلِينَۖ"},{"n":17,"text":"ثُمَّ نُتْبِعُهُمُ اُ۬لَاخِرِينَۖ"},{"n":18,"text":"كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ"},{"n":19,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ"},{"n":21,"text":"فَجَعَلْنَٰهُ فِے قَر۪ارٖ مَّكِينٍ"},{"n":22,"text":"اِلَىٰ قَدَرٖ مَّعْلُومٖ"},{"n":23,"text":"فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ"},{"n":24,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":25,"text":"أَلَمْ نَجْعَلِ اِ۬لَارْضَ كِفَاتاً"},{"n":26,"text":"اَحْيَآءٗ وَأَمْوَٰتاٗ"},{"n":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ"},{"n":28,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":29,"text":"اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"n":30,"text":"اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ"},{"n":31,"text":"لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ"},{"n":32,"text":"إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ"},{"n":33,"text":"كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ"},{"n":34,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ"},{"n":36,"text":"وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَۖ"},{"n":37,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":38,"text":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ"},{"n":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ"},{"n":40,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":41,"text":"إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ"},{"n":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ"},{"n":43,"text":"كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ"},{"n":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"n":45,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":46,"text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلاً اِنَّكُم مُّجْرِمُونَۖ"},{"n":47,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":48,"text":"وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ"},{"n":49,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"n":50,"text":"فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَۖ"}]}