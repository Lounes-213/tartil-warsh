{"id":81,"name":"التكوير","ayahs":[{"n":1,"text":"إِذَا اَ۬لشَّمْسُ كُوِّرَتْ"},{"n":2,"text":"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ"},{"n":3,"text":"وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ"},{"n":4,"text":"وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ"},{"n":5,"text":"وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ"},{"n":6,"text":"وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ"},{"n":7,"text":"وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ"},{"n":8,"text":"وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ"},{"n":9,"text":"بِأَيِّ ذَنۢبٖ قُتِلَتْ"},{"n":10,"text":"وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ"},{"n":11,"text":"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ"},{"n":12,"text":"وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ"},{"n":13,"text":"وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ"},{"n":14,"text":"عَلِمَتْ نَفْسٞ مَّآ أَحْضَرَتْۖ"},{"n":15,"text":"فَلَآ أُقْسِمُ بِالْخُنَّسِ"},{"n":16,"text":"اِ۬لْجَوَارِ اِ۬لْكُنَّسِ"},{"n":17,"text":"وَاليْلِ إِذَا عَسْعَسَ"},{"n":18,"text":"وَالصُّبْحِ إِذَا تَنَفَّسَ"},{"n":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ"},{"n":20,"text":"ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ"},{"n":21,"text":"مُّطَاعٖ ثَمَّ أَمِينٖۖ"},{"n":22,"text":"وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ"},{"n":23,"text":"وَلَقَدْ ر۪ء۪اهُ بِالُافُقِ اِ۬لْمُبِينِۖ"},{"n":24,"text":"وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ"},{"n":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ"},{"n":26,"text":"فَأَيْنَ تَذْهَبُونَۖ"},{"n":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ"},{"n":28,"text":"لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّسْتَقِيمَۖ"},{"n":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ"}]}