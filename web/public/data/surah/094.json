{"id":94,"name":"الشرح","ayahs":[{"n":1,"text":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"n":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"n":3,"text":"اَ۬لذِےٓ أَنقَضَ ظَهْرَكَ"},{"n":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَۖ"},{"n":5,"text":"فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً"},{"n":6,"text":"اِنَّ مَعَ اَ۬لْعُسْرِ يُسْراٗۖ"},{"n":7,"text":"فَإِذَا فَرَغْتَ فَانصَبْ"},{"n":8,"text":"وَإِلَىٰ رَبِّكَ فَارْغَبْۖ"}]}