{"id":93,"name":"الضحى","ayahs":[{"n":1,"text":"وَالضُّح۪ىٰ"},{"n":2,"text":"وَاليْلِ إِذَا سَج۪ىٰ"},{"n":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪ىٰۖ"},{"n":4,"text":"وَلَلَاخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لُاول۪ىٰۖ"},{"n":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪ىٰٓۖ"},{"n":6,"text":"أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاو۪ىٰ"},{"n":7,"text":"وَوَجَدَكَ ضَآلّاٗ فَهَد۪ىٰ"},{"n":8,"text":"وَوَجَدَكَ عَآئِلاٗ فَأَغْن۪ىٰۖ"},{"n":9,"text":"فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ"},{"n":10,"text":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ"},{"n":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ"}]}