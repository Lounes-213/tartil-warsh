{"id":87,"name":"الأعلى","ayahs":[{"n":1,"text":"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لَاعْلَي"},{"n":2,"text":"اَ۬لذِے خَلَقَ فَسَوّ۪ىٰ"},{"n":3,"text":"وَالذِے قَدَّرَ فَهَد۪ىٰ"},{"n":4,"text":"وَالذِےٓ أَخْرَجَ اَ۬لْمَرْع۪ىٰ"},{"n":5,"text":"فَجَعَلَهُۥ غُثَآءً اَحْو۪ىٰۖ"},{"n":6,"text":"سَنُقْرِئُكَ فَلَا تَنس۪ىٰٓ"},{"n":7,"text":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْف۪ىٰۖ"},{"n":8,"text":"وَنُيَسِّرُكَ لِلْيُسْر۪ىٰۖ"},{"n":9,"text":"فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪ىٰۖ"},{"n":10,"text":"سَيَذَّكَّرُ مَنْ يَّخْش۪ىٰ"},{"n":11,"text":"وَيَتَجَنَّبُهَا اَ۬لَاشْقَي"},{"n":12,"text":"اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْر۪ىٰ"},{"n":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْي۪ىٰۖ"},{"n":14,"text":"قَدَ اَفْلَحَ مَن تَزَكّ۪ىٰ"},{"n":15,"text":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلّ۪ىٰۖ"},{"n":16,"text":"بَلْ تُوثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا"},{"n":17,"text":"وَالَاخِرَةُ خَيْرٞ وَأَبْق۪ىٰٓۖ"},{"n":18,"text":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لُاول۪ىٰ"},{"n":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوس۪ىٰۖ"}]}