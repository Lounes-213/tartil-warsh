{"id":114,"name":"الناس","ayahs":[{"n":1,"text":"قُلَ اَعُوذُ بِرَبِّ اِ۬لنَّاسِ"},{"n":2,"text":"مَلِكِ اِ۬لنَّاسِ"},{"n":3,"text":"إِلَٰهِ اِ۬لنَّاسِ"},{"n":4,"text":"مِن شَرِّ اِ۬لْوَسْوَاسِ اِ۬لْخَنَّاسِ"},{"n":5,"text":"اِ۬لذِے يُوَسْوِسُ فِے صُدُورِ اِ۬لنَّاسِ"},{"n":6,"text":"مِنَ اَ۬لْجِنَّةِ وَالنَّاسِۖ"}]}