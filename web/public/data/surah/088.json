{"id":88,"name":"الغاشية","ayahs":[{"n":1,"text":"هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ"},{"n":2,"text":"وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ"},{"n":3,"text":"عَامِلَةٞ نَّاصِبَةٞ"},{"n":4,"text":"تَصْلَىٰ نَاراً حَامِيَةٗ"},{"n":5,"text":"تُسْق۪ىٰ مِنْ عَيْنٍ اٰنِيَةٖۖ"},{"n":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ اِلَّا مِن ضَرِيعٖ"},{"n":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ"},{"n":8,"text":"وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ"},{"n":9,"text":"لِّسَعْيِهَا رَاضِيَةٞ"},{"n":10,"text":"فِے جَنَّةٍ عَالِيَةٖ"},{"n":11,"text":"لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ"},{"n":12,"text":"فِيهَا عَيْنٞ جَارِيَةٞۖ"},{"n":13,"text":"فِيهَا سُرُرٞ مَّرْفُوعَةٞ"},{"n":14,"text":"وَأَكْوَابٞ مَّوْضُوعَةٞ"},{"n":15,"text":"وَنَمَارِقُ مَصْفُوفَةٞ"},{"n":16,"text":"وَزَرَابِيُّ مَبْثُوثَةٌۖ"},{"n":17,"text":"اَفَلَا يَنظُرُونَ إِلَى اَ۬لِابِلِ كَيْفَ خُلِقَتْ"},{"n":18,"text":"وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ"},{"n":19,"text":"وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ"},{"n":20,"text":"وَإِلَى اَ۬لَارْضِ كَيْفَ سُطِحَتْۖ"},{"n":21,"text":"فَذَكِّرِ اِنَّمَآ أَنتَ مُذَكِّرٞۖ"},{"n":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ"},{"n":23,"text":"اِلَّا مَن تَوَلّ۪ىٰ وَكَفَرَ"},{"n":24,"text":"فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لْعَذَابَ اَ۬لَاكْبَرَۖ"},{"n":25,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"n":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمْۖ"}]}