{"id":100,"name":"العاديات","ayahs":[{"n":1,"text":"وَالْعَٰدِيَٰتِ ضَبْحاٗ"},{"n":2,"text":"فَالْمُورِيَٰتِ قَدْحاٗ"},{"n":3,"text":"فَالْمُغِيرَٰتِ صُبْحاٗ"},{"n":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعاٗ"},{"n":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعاً"},{"n":6,"text":"اِنَّ اَ۬لِانسَٰنَ لِرَبِّهِۦ لَكَنُودٞ"},{"n":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ"},{"n":8,"text":"وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ"},{"n":9,"text":"اَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ"},{"n":10,"text":"وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ"},{"n":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرٌۖ"}]}