{"id":82,"name":"الإنفطار","ayahs":[{"n":1,"text":"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ"},{"n":2,"text":"وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ"},{"n":3,"text":"وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ"},{"n":4,"text":"وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ"},{"n":5,"text":"عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ"},{"n":6,"text":"يَٰٓأَيُّهَا اَ۬لِانسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ"},{"n":7,"text":"اِ۬لذِے خَلَقَكَ فَسَوّ۪يٰكَ فَعَدَّلَكَ"},{"n":8,"text":"فِےٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ"},{"n":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"},{"n":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"},{"n":11,"text":"كِرَاماٗ كَٰتِبِينَ"},{"n":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَۖ"},{"n":13,"text":"إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٖۖ"},{"n":14,"text":"وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ"},{"n":15,"text":"يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ"},{"n":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ"},{"n":17,"text":"وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِ"},{"n":18,"text":"ثُمَّ مَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِۖ"},{"n":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَئْاٗۖ وَالَامْرُ يَوْمَئِذٖ لِّلهِۖ"}]}