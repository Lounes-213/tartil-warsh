{"id":102,"name":"التكاثر","ayahs":[{"n":1,"text":"اَلْه۪يٰكُمُ اُ۬لتَّكَاثُرُ"},{"n":2,"text":"حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ"},{"n":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"n":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ"},{"n":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ"},{"n":6,"text":"لَتَرَوُنَّ اَ۬لْجَحِيمَ"},{"n":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ"},{"n":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ"}]}