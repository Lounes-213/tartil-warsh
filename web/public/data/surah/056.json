{"id":56,"name":"الواقعة","ayahs":[{"n":1,"text":"إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ"},{"n":2,"text":"لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ"},{"n":3,"text":"خَافِضَةٞ رَّافِعَةٌ"},{"n":4,"text":"اِذَا رُجَّتِ اِ۬لَارْضُ رَجّاٗ"},{"n":5,"text":"وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ"},{"n":6,"text":"فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ"},{"n":7,"text":"وَكُنتُمُۥٓ أَزْوَٰجاٗ ثَلَٰثَةٗۖ"},{"n":8,"text":"فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ"},{"n":9,"text":"مَآ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"n":10,"text":"وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ"},{"n":11,"text":"مَآ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"},{"n":12,"text":"وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ"},{"n":13,"text":"أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ"},{"n":14,"text":"فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ"},{"n":15,"text":"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ"},{"n":16,"text":"وَقَلِيلٞ مِّنَ اَ۬لَاخِرِينَ"},{"n":17,"text":"عَلَىٰ سُرُرٖ مَّوْضُونَةٖ"},{"n":18,"text":"مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ"},{"n":19,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ"},{"n":20,"text":"بِأَكْوَابٖ وَأَبَارِيقَ"},{"n":21,"text":"وَكَأْسٖ مِّن مَّعِينٖ"},{"n":22,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ"},{"n":23,"text":"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ"},{"n":24,"text":"وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ"},{"n":25,"text":"وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ"},{"n":26,"text":"جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ"},{"n":27,"text":"لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَاثِيماًۖ"},{"n":28,"text":"اِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ"},{"n":29,"text":"وَأَصْحَٰبُ اُ۬لْيَمِينِ مَآ أَصْحَٰبُ اُ۬لْيَمِينِۖ"},{"n":30,"text":"فِے سِدْرٖ مَّخْضُودٖ"},{"n":31,"text":"وَطَلْحٖ مَّنضُودٖ"},{"n":32,"text":"وَظِلّٖ مَّمْدُودٖ"},{"n":33,"text":"وَمَآءٖ مَّسْكُوبٖ"},{"n":34,"text":"وَفَٰكِهَةٖ كَثِيرَةٖ"},{"n":35,"text":"لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ"},{"n":36,"text":"وَفُرُشٖ مَّرْفُوعَةٍۖ"},{"n":37,"text":"اِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءٗ"},{"n":38,"text":"فَجَعَلْنَٰهُنَّ أَبْكَاراً"},{"n":39,"text":"عُرُباً اَتْرَاباٗ"},{"n":40,"text":"لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ"},{"n":41,"text":"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ"},{"n":42,"text":"وَثُلَّةٞ مِّنَ اَ۬لَاخِرِينَۖ"},{"n":43,"text":"وَأَصْحَٰبُ اُ۬لشِّمَالِ"},{"n":44,"text":"مَآ أَصْحَٰبُ اُ۬لشِّمَالِۖ"},{"n":45,"text":"فِے سَمُومٖ وَحَمِيمٖ"},{"n":46,"text":"وَظِلّٖ مِّنْ يَّحْمُومٖ"},{"n":47,"text":"لَّا بَارِدٖ وَلَا كَرِيمٍۖ"},{"n":48,"text":"اِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ"},{"n":49,"text":"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ"},{"n":50,"text":"وَكَانُواْ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ"},{"n":51,"text":"أَوَءَابَآؤُنَا اَ۬لَاوَّلُونَۖ"},{"n":52,"text":"قُلِ اِنَّ اَ۬لَاوَّلِينَ وَالَاخِرِينَ لَمَجْمُوعُونَ"},{"n":53,"text":"إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ"},{"n":54,"text":"ثُمَّ إِنَّكُمُۥٓ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ"},{"n":55,"text":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ"},{"n":56,"text":"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"},{"n":57,"text":"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ"},{"n":58,"text":"فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ"},{"n":59,"text":"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ"},{"n":60,"text":"نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ"},{"n":61,"text":"أَفَرَٰٓيْتُم مَّا تُمْنُونَ"},{"n":62,"text":"ءَآنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ"},{"n":63,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"n":64,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ"},{"n":65,"text":"وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لُاول۪ىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ"},{"n":66,"text":"أَفَرَٰٓيْتُم مَّا تَحْرُثُونَ"},{"n":67,"text":"ءَآنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ"},{"n":68,"text":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ"},{"n":69,"text":"إِنَّا لَمُغْرَمُونَ"},{"n":70,"text":"بَلْ نَحْنُ مَحْرُومُونَۖ"},{"n":71,"text":"أَفَرَٰٓيْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ"},{"n":72,"text":"ءَآنتُمُۥٓ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ"},{"n":73,"text":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗۖ فَلَوْلَا تَشْكُرُونَۖ"},{"n":74,"text":"أَفَرَٰٓيْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ"},{"n":75,"text":"ءَآنتُمُۥٓ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ اُ۬لْمُنشِـُٔونَۖ"},{"n":76,"text":"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةٗ وَمَتَٰعاٗ لِّلْمُقْوِينَۖ"},{"n":77,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"},{"n":78,"text":"فَلَآ أُقْسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ"},{"n":79,"text":"وَإِنَّهُۥ لَقَسَمٞ لَّوْ تَعْلَمُونَ عَظِيمٌ"},{"n":80,"text":"اِنَّهُۥ لَقُرْءَانٞ كَرِيمٞ"},{"n":81,"text":"فِے كِتَٰبٖ مَّكْنُونٖ"},{"n":82,"text":"لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لْمُطَهَّرُونَۖ"},{"n":83,"text":"تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ"},{"n":84,"text":"أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"n":85,"text":"وَتَجْعَلُونَ رِزْقَكُمُۥٓ أَنَّكُمْ تُكَذِّبُونَۖ"},{"n":86,"text":"فَلَوْلَآ إِذَا بَلَغَتِ اِ۬لْحُلْقُومَ"},{"n":87,"text":"وَأَنتُمْ حِينَئِذٖ تَنظُرُونَ"},{"n":88,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ"},{"n":89,"text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"n":90,"text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَۖ"},{"n":91,"text":"فَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ"},{"n":92,"text":"فَرَوْحٞ وَرَيْحَانٞ وَجَنَّتُ نَعِيمٖۖ"},{"n":93,"text":"وَأَمَّآ إِن كَانَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِ"},{"n":94,"text":"فَسَلَٰمٞ لَّكَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِۖ"},{"n":95,"text":"وَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُكَذِّبِينَ اَ۬لضَّآلِّينَ"},{"n":96,"text":"فَنُزُلٞ مِّنْ حَمِيمٖ"},{"n":97,"text":"وَتَصْلِيَةُ جَحِيمٍۖ"},{"n":98,"text":"اِنَّ هَٰذَا لَهُوَ حَقُّ اُ۬لْيَقِينِۖ"},{"n":99,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"}]}