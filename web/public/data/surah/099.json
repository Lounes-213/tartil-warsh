{"id":99,"name":"الزلزلة","ayahs":[{"n":1,"text":"إِذَا زُلْزِلَتِ اِ۬لَارْضُ زِلْزَالَهَا"},{"n":2,"text":"وَأَخْرَجَتِ اِ۬لَارْضُ أَثْقَالَهَا"},{"n":3,"text":"وَقَالَ اَ۬لِانسَٰنُ مَا لَهَا"},{"n":4,"text":"يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا"},{"n":5,"text":"بِأَنَّ رَبَّكَ أَوْح۪ىٰ لَهَاۖ"},{"n":6,"text":"يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ"},{"n":7,"text":"لِّيُرَوَاْ اَعْمَٰلَهُمْۖ"},{"n":8,"text":"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ"},{"n":9,"text":"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ"}]}