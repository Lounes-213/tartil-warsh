{"id":89,"name":"الفجر","ayahs":[{"n":1,"text":"وَالْفَجْرِ"},{"n":2,"text":"وَلَيَالٍ عَشْرٖ"},{"n":3,"text":"وَالشَّفْعِ وَالْوَتْرِ"},{"n":4,"text":"وَاليْلِ إِذَا يَسْرِۦ"},{"n":5,"text":"هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ"},{"n":6,"text":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"n":7,"text":"اِرَمَ ذَاتِ اِ۬لْعِمَادِ"},{"n":8,"text":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ"},{"n":9,"text":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ"},{"n":10,"text":"وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ"},{"n":11,"text":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ"},{"n":12,"text":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ"},{"n":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ"},{"n":14,"text":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ"},{"n":15,"text":"فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ"},{"n":16,"text":"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ"},{"n":17,"text":"وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ"},{"n":18,"text":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"n":19,"text":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ"},{"n":20,"text":"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ"},{"n":21,"text":"وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ"},{"n":22,"text":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ"},{"n":23,"text":"كَلَّآۖ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ"},{"n":24,"text":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ"},{"n":25,"text":"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ"},{"n":26,"text":"يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪ىٰ لَهُ اُ۬لذِّكْر۪ىٰۖ"},{"n":27,"text":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ"},{"n":28,"text":"فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"},{"n":29,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ"},{"n":30,"text":"يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ"},{"n":31,"text":"اُ۪رْجِعِےٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ"},{"n":32,"text":"فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ"}]}