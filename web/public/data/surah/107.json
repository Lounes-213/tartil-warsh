{"id":107,"name":"الماعون","ayahs":[{"n":1,"text":"اَرَٰٓيْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ"},{"n":2,"text":"فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ"},{"n":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ"},{"n":4,"text":"فَوَيْلٞ لِّلْمُصَلِّينَ"},{"n":5,"text":"اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"n":6,"text":"اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ"}]}